    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'autoheal-rs'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["run", "--bin=autoheal-rs"]
            },
            "args": []
        },
        {
            "name": "Debug executable 'autoheal-rs' over http",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--no-run", "--bin=autoheal-rs"]
            },
            "args": [],
            "env": {
                "DOCKER_SOCK": "tcp://localhost:2376"
            }
        },
        {
            "name": "Debug unit tests in executable 'autoheal-rs'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--bin=autoheal-rs"]
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug integration test 'integration_tests'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["test", "--no-run", "--test=integration_tests"]
            },
            "args": []
        }
    ]
}
